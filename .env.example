# =============================================================================
# Environment Variables for Study Smart
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# Django Settings
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated. In prod use your real https origins:
#   CSRF_TRUSTED_ORIGINS=https://studyai.app,https://www.studyai.app
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost,http://127.0.0.1

# HTTPS hardening (only applied when DEBUG=False). On a brand-new domain you may
# want SECURE_HSTS_SECONDS=0 for the first deploy, then ramp up.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# Qwen / DashScope API (optional — primary AI provider; falls back to Gemini)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Database (PostgreSQL)
DATABASE_NAME=study_smart
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-to-a-strong-password
DATABASE_HOST=db
DATABASE_PORT=5432

# Stripe Payments (Test Mode)
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (SMTP) — required in production for magic-link login
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@studysmart.com

# Celery / Redis (async AI generation)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Shared cache for rate limiting across workers (leave blank for local LocMemCache)
REDIS_CACHE_URL=redis://redis:6379/1

# Sentry (error monitoring) — leave blank to disable
SENTRY_DSN=
